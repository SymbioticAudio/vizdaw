  "styles": {
    "labels": {"description": "How control labels and section heads are set: as written, lower case, capitals, or condensed bold capitals", "since": "0.2.0", "values": ["plain", "lowercase", "caps", "condensedCaps"]},
    "legendFamily": {"description": "Font family of names, section legends, buttons and menus: the system sans, the system serif, or the technical sans (DIN Alternate, else the system sans)", "since": "0.2.0", "values": ["system", "serif", "technical"]},
